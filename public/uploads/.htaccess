# Uploaded menu photos only. Never execute anything from here.
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|html?|svg)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'none'; img-src 'self'"
  Header set X-Content-Type-Options "nosniff"
</IfModule>
