# Admin app: never indexed; service worker and manifest must always be revalidated.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
  <Files "manifest.webmanifest">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
